# SkillProof Environment Variables

# Database Configuration
# For development: DATABASE_URL="postgresql://user:password@localhost:5432/skillproof"
# For production (Render): DATABASE_URL is automatically provided by Render database

# Backend Server Configuration
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# AI Processing (Optional - for enhanced resume parsing)
GEMINI_API_KEY="your-gemini-api-key-optional"

# GitHub Integration (Optional - for private repository access)
GITHUB_TOKEN="your-github-token-optional"

# Frontend Configuration
# For development with Vite proxy: VITE_API_URL="/api"
# For direct backend connection: VITE_API_URL="http://localhost:3001"
VITE_API_URL="/api"

# File Storage (For Render/Production use object storage)
# For local development, files are stored in memory
STORAGE_TYPE="local"
# For production, configure AWS S3 or similar:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""
