# SkillProof Environment Variables

# Database Configuration
# For development: DATABASE_URL="postgresql://user:password@localhost:5432/skillproof"
# For production (Render): DATABASE_URL is automatically provided by Render database
DATABASE_URL="postgresql://user:password@localhost:5432/skillproof"

# Backend Server Configuration (Python FastAPI)
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:3000"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# AI Processing (Optional - for enhanced resume parsing)
GEMINI_API_KEY="your-gemini-api-key-optional"

# GitHub Integration (Optional - for private repository access)
GITHUB_TOKEN="your-github-token-optional"

# Frontend Configuration
# For development with Vite proxy: VITE_API_URL="/api"
# For direct backend connection: VITE_API_URL="http://localhost:8000"
# For production: VITE_API_URL="https://geeks2.onrender.com"
VITE_API_URL="https://geeks2.onrender.com"
